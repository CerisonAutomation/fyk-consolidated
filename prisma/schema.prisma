// =============================================================================

model ProfileEmbedding {
  id        String                     @id @default(uuid()) @db.Uuid
  profileId String                     @map("profile_id") @db.Uuid
  embedding Unsupported("vector(384)")
  model     String                     @default("all-MiniLM-L6-v2")
  createdAt DateTime                   @default(now()) @map("created_at")
  updatedAt DateTime                   @updatedAt @map("updated_at")

  user User @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, model])
  @@map("profile_embeddings")
}

model MessageEmbedding {
  id        String                     @id @default(uuid()) @db.Uuid
  messageId String                     @map("message_id") @db.Uuid
  embedding Unsupported("vector(384)")
  createdAt DateTime                   @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId])
  @@map("message_embeddings")
}

model TagEmbedding {
  id        String                     @id @default(uuid()) @db.Uuid
  tag       String                     @unique
