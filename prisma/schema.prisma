// =============================================================================
// Offers & Events
// =============================================================================

model Offer {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  activityIds String[]  @default([]) @map("activity_ids")
  note        String?
  whereMode   WhereMode @default(out) @map("where_mode")
  spots       Int?
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([expiresAt(sort: Desc)])
  @@map("offers")
}

model Event {
  id           String        @id @default(uuid()) @db.Uuid
  hostId       String        @map("host_id") @db.Uuid
  title        String
  description  String?
  activityId   String?       @map("activity_id")
  scale        String        @default("casual")
  cost         String?
  venue        String?
  address      String?
  city         String?
  lat          Float?
  lng          Float?
  startsAt     DateTime      @map("starts_at")
  endsAt       DateTime?     @map("ends_at")
  capacity     Int?
  explicitness ExposureLevel @default(clean)
  status       String        @default("published")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  host      User            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  rsvps     EventRsvp[]
  waitlists EventWaitlist[]

  @@index([startsAt])
  @@index([city, startsAt])
  @@map("events")
}

model EventRsvp {
  eventId   String     @map("event_id") @db.Uuid
  profileId String     @map("profile_id") @db.Uuid
  status    RsvpStatus @default(going)
  createdAt DateTime   @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([eventId, profileId])
  @@map("event_rsvps")
}

model EventWaitlist {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("event_waitlist")
}

// =============================================================================
// Board (Posts, Comments)
// =============================================================================

model BoardPost {
  id          String   @id @default(uuid()) @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  kind        PostKind @default(text)
  body        String
  activityId  String?  @map("activity_id")
  storagePath String?  @map("storage_path")
  city        String?
  area        String?
  spots       Int?
  joinCount   Int      @default(0) @map("join_count")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments BoardComment[]

  @@index([expiresAt(sort: Desc), createdAt(sort: Desc)])
  @@map("board_posts")
}

model BoardComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  post   BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("board_comments")
}

// =============================================================================
// User Notes
// =============================================================================

model UserNote {
  id           String   @id @default(uuid()) @db.Uuid
  noteOwnerId  String   @map("note_owner_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  content      String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  noteOwner  User @relation("NoteOwner", fields: [noteOwnerId], references: [id], onDelete: Cascade)
  targetUser User @relation("NoteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([noteOwnerId, targetUserId])
  @@map("user_notes")
}

// =============================================================================
// Push Subscriptions
// =============================================================================

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Required by POST /api/push/subscribe: two devices registering the same
  // endpoint concurrently used to race into duplicate rows (find-then-create).
  @@unique([userId, endpoint], map: "push_subscriptions_user_id_endpoint_key")
  @@index([userId], map: "push_subscriptions_user_id_idx")
  @@map("push_subscriptions")
}

// =============================================================================
// Site Config
// =============================================================================

model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("site_config")
}

