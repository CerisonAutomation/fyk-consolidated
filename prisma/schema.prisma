// =============================================================================
// FYK Consolidated — Prisma Schema
// =============================================================================
// Models shaped to match the Prisma adapter layer (camelCase field names).
// SQL column mappings use @map where Prisma conventions differ.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

enum ExposureLevel {
  clean
  mature
  explicit
}

enum LikeKind {
  like
  tap
  woof
}

enum GrantStatus {
  pending
  approved
  denied
  revoked
}

enum RsvpStatus {
  going
  maybe
  declined
}

enum MessageType {
  text
  image
  video
  audio
  system
  album_request
  album_share
}

enum ReportStatus {
  open
  in_review
  action_taken
  dismissed
}

enum PostKind {
  invite
  offer
  ask
  photo
  text
}

enum WhereMode {
  out
  mine
  yours
  either
}

enum PlanTier {
  free
  plus
  gold
  platinum
}

enum MediaAccessPolicy {
  standard
  timed
  view_once
  open_count
}

enum SharedMediaStatus {
  pending
  active
  declined
  expired
  revoked
  consumed
  failed
}

// =============================================================================
// User (core — maps to SQL `users` table + adapter fields)
// =============================================================================

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  phone        String?
  passwordHash String  @map("password_hash")

  // Display
  name        String? @map("pseudo") // SQL: users.pseudo
  handle      String? @map("nick") // SQL: users.nick
  bio         String? @map("description") // SQL: users.description
  gender      String? // adapter field (not in SQL users)
  pronouns    String?
  intents     Json?   @default("[]")
  dateOfBirth DateTime? @map("birthday")
  age         Int?
  occupation  String?
  ethnicity   String?
  height      Int?
  weight      Int?
  bodyType    String?   @map("body_type")
  position    Json?   @default("[]") // SQL: jsonb string array

  // Arrays (JSON columns)
  lookingForTags Json     @default("[]") @map("looking_for") // SQL: jsonb
  interests      Json     @default("[]")
  tribes         Json     @default("[]")
  tagCodes       Json     @map("tag_codes")
  languages      Json     @default("[]")
  photos         Json     @default("[]")
  avatar         String?

  // Location
  lat       Float?
  lng       Float?
  latCoarse Float?  @map("lat_coarse")
  lngCoarse Float?  @map("lng_coarse")
  city      String?
  area      String?
  geoMode   String? @map("geo_mode")
  h3Index   String? @map("h3_index")

  // Status / visibility
  status        String? @default("online")
  role          String? @default("user")
  tier          String? @default("free")
  premiumTier   String? @default("none")
  isPremium     Boolean @default(false)
  online        Boolean @default(false)
  visible       Boolean @default(true)
  hidden        Boolean @default(false)
  incognitoMode Boolean @default(false) @map("incognito")
  isDemo        Boolean @default(false) @map("is_demo")
  isSuspended   Boolean @default(false) @map("is_suspended")
  hideDistance  Boolean @default(false) @map("hide_distance")
  hideOnline    Boolean @default(false) @map("hide_online")
  contentRating String  @default("clean") @map("exposure_level") // SQL: users.exposure_level

  // Verification / trust
  verification    Int?    @default(0)
  verifiedType    String?
  trustScore      Int?    @default(50) @map("trust_score")
  profileComplete Int?    @default(0) @map("profile_complete")

  // Appearance / preferences
  themePreference String?  @map("theme")
  accent          String?
  fontSize        Int?     @default(16) @map("font_size")
  gridColumns     Int?     @default(2) @map("grid_columns")
  cardStyle       String?  @map("card_style")
  dndMode         Boolean? @default(false) @map("dnd_mode")
  colorblindMode  Boolean? @default(false) @map("colorblind_mode")
  language        String?  @default("en")

  // Notification / AI prefs (JSON)
  notifPrefs Json @default("{}") @map("notif_prefs")
  aiPrefs    Json @default("{}") @map("ai_prefs")

  // Auth
  appleId  String? @map("apple_id")
  googleId String? @map("google_id")

  // Pet interaction fields (adapter references — read from king_pet via relation)
  lastFed         DateTime?
  costume         String?
  activity        String?
  adventureEndsAt DateTime?

  // Cursor / tracking
  lastCursor String?   @map("last_cursor")
  lastSeenAt DateTime? @map("last_seen")
  lastActive DateTime? @map("last_active_at")

  // Onboarding
  onboardingDone        Boolean?  @default(false) @map("onboarding_done")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  // Soft delete (adapter field)
  deletedAt DateTime?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  sessions                   Session[]
  tapsMade                   Tap[]                     @relation("Tapper")
  tapsReceived               Tap[]                     @relation("Tapped")
  favoritesOwned             Favorite[]                @relation("FavoriteUser")
  favoritesReceived          Favorite[]                @relation("FavoriteProfile")
  footprintsVisited          Footprint[]               @relation("Visitor")
  footprintsReceived         Footprint[]               @relation("Visited")
  savedFilters               SavedFilter[]
  savedPhrases               SavedPhrase[]
  groupsCreated              Group[]                   @relation("GroupCreator")
  groupMemberships           GroupMember[]
  groupMessages              GroupMessage[]
  stories                    Story[]
  storyViews                 StoryView[]               @relation("StoryViewer")
  shouts                     Shout[]
  shoutLikes                 ShoutLike[]
  fansites                   Fansite[]
  meetNowPosts               MeetNowPost[]
  kingPet                    KingPet?
  wallet                     Wallet?
  subscriptions              Subscription[]
  consumablesInventories     ConsumablesInventory[]
  userNotes                  UserNote[]                @relation("NoteOwner")
  userNotesReceived          UserNote[]                @relation("NoteTarget")
  notifications              Notification[]
  notificationsActor         Notification[]            @relation("NotificationActor")
  pushSubscriptions          PushSubscription[]
  aiMemories                 AiMemory[]
  aiSuggestions              AiSuggestion[]
  eventWaitlists             EventWaitlist[]
  sentMessages               Message[]                 @relation("MessageSender")
  messageReads               MessageRead[]
  conversationParticipations ConversationParticipant[]
  messageReactions           MessageReaction[]
  albumGrantsOwned           AlbumGrant[]              @relation("AlbumGrantOwner")
  albumGrantsReceived        AlbumGrant[]              @relation("AlbumGrantGrantee")
  matchesA                   Match[]                   @relation("MatchUserA")
  matchesB                   Match[]                   @relation("MatchUserB")
  blocksMade                 Block[]                   @relation("Blocker")
  blocksReceived             Block[]                   @relation("Blocked")
  reportsMade                Report[]                  @relation("Reporter")
  profileEmbeddings          ProfileEmbedding[]
  boardPosts                 BoardPost[]
  boardComments              BoardComment[]
  offers                     Offer[]
  events                     Event[]
  eventRsvps                 EventRsvp[]
  premiumEntitlement         PremiumEntitlement?
  likesMade                  Like[]                    @relation("LikeFrom")
  likesReceived              Like[]                    @relation("LikeTo")
  typingIndicators           TypingIndicator[]

  @@map("users")
}

// =============================================================================
// Sessions
// =============================================================================

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  device    String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// =============================================================================
// Social Graph — Taps, Likes, Matches, Favorites, Blocks, Reports
// =============================================================================

model Tap {
  id        String   @id @default(uuid()) @db.Uuid
  fromId    String   @map("tapper_id") @db.Uuid
  toId      String   @map("tapped_id") @db.Uuid
  kind      String?  @default("like")
  isSuper   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tapper User @relation("Tapper", fields: [fromId], references: [id], onDelete: Cascade)
  tapped User @relation("Tapped", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([fromId, createdAt(sort: Desc)])
  @@index([toId, createdAt(sort: Desc)])
  @@map("taps")
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  fromId    String   @map("from_id") @db.Uuid
  toId      String   @map("to_id") @db.Uuid
  kind      LikeKind @default(like)
  createdAt DateTime @default(now()) @map("created_at")

  from User @relation("LikeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("LikeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId, createdAt(sort: Desc)])
  @@map("likes")
}

model Match {
  id          String    @id @default(uuid()) @db.Uuid
  user1Id     String    @map("user_a") @db.Uuid
  user2Id     String    @map("user_b") @db.Uuid
  matchType   String?   @default("like")
  createdAt   DateTime  @default(now()) @map("created_at")
  unmatchedAt DateTime? @map("unmatched_at")

  userA User @relation("MatchUserA", fields: [user1Id], references: [id], onDelete: Cascade)
  userB User @relation("MatchUserB", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@map("matches")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  profileId String   @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User @relation("FavoriteUser", fields: [userId], references: [id], onDelete: Cascade)
  profile User @relation("FavoriteProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@map("favorites")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  fromId    String   @map("blocker_id") @db.Uuid
  toId      String   @map("blocked_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [fromId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
  @@map("blocks")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  reportedId String       @map("target_id") @db.Uuid
  reason     String
  details    String?
  evidence   Json         @default("[]")
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now()) @map("created_at")

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@map("reports")
}

// =============================================================================
// Footprints
// =============================================================================

model Footprint {
  id        String   @id @default(uuid()) @db.Uuid
  visitorId String   @map("visitor_id") @db.Uuid
  visitedId String   @map("visited_id") @db.Uuid
  preset    String?
  createdAt DateTime @default(now()) @map("created_at")

  visitor User @relation("Visitor", fields: [visitorId], references: [id], onDelete: Cascade)
  visited User @relation("Visited", fields: [visitedId], references: [id], onDelete: Cascade)

  @@map("footprints")
}

// =============================================================================
// Stories
// =============================================================================

model Story {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  mediaUrl   String   @map("media_url")
  mediaType  String   @default("image") @map("media_type")
  caption    String?
  background String?
  viewedBy   Json     @default("[]")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views StoryView[]

  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id       String   @id @default(uuid()) @db.Uuid
  storyId  String   @map("story_id") @db.Uuid
  viewerId String   @map("user_id") @db.Uuid
  viewedAt DateTime @default(now()) @map("viewed_at")

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("story_views")
}

// =============================================================================
// Shouts (Social Feed)
// =============================================================================

model Shout {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  content      String
  mediaUrl     String?  @map("media_url")
  status       String   @default("published")
  likeCount    Int      @default(0) @map("likes_count")
  commentCount Int      @default(0)
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes ShoutLike[]

  @@index([createdAt(sort: Desc)])
  @@map("shouts")
}

model ShoutLike {
  id        String   @id @default(uuid()) @db.Uuid
  shoutId   String   @map("shout_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  shout Shout @relation(fields: [shoutId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shoutId, userId])
  @@map("shout_likes")
}

// =============================================================================
// Conversations & Messaging
// =============================================================================

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  type          String   @default("dm")
  name          String?
  matchId       String?  @map("match_id") @db.Uuid
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt

  participants     ConversationParticipant[]
  messages         Message[]
  typingIndicators TypingIndicator[]
  aiChatHealth     AiChatHealth[]
  albumShares      AlbumShare[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("profile_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  archivedAt     DateTime? @map("archived_at")
  unreadCount    Int       @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  type           MessageType @default(text)
  content        String?     @map("body")
  mediaUrl       String?     @map("storage_path")
  replyToId      String?     @map("reply_to_id") @db.Uuid
  albumShareId   String?     @map("album_share_id") @db.Uuid
  reactions      Json        @default("[]")
  isEdited       Boolean     @default(false)
  isDeleted      Boolean     @default(false)
  isEphemeral    Boolean     @default(false)
  expiresAt      DateTime?   @map("expires_at")
  unsentAt       DateTime?   @map("unsent_at")
  editedAt       DateTime?   @map("edited_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo            Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies            Message[]           @relation("MessageReplies")
  reads              MessageRead[]
  reactions2         MessageReaction[]
  aiSafetyFlags      AiSafetyFlag[]
  messageAttachments MessageAttachment[]
  messageEmbedding   MessageEmbedding?

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("messages")
}

model MessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_reads")
}

model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("profile_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@map("message_reactions")
}

model TypingIndicator {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("typing_indicators")
}

// =============================================================================
// Messaging — Attachments, Albums, Album Shares
// =============================================================================

model MessageAttachment {
  id             String            @id @default(uuid()) @db.Uuid
  messageId      String            @map("message_id") @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  senderId       String            @map("sender_id") @db.Uuid
  storagePath    String            @map("storage_path")
  mediaKind      String            @map("media_kind")
  mimeType       String            @map("mime_type")
  caption        String?
  width          Int?
  height         Int?
  bytes          Int?
  accessPolicy   MediaAccessPolicy @default(standard) @map("access_policy")
  expiresAt      DateTime?         @map("expires_at")
  maxOpens       Int?              @map("max_opens")
  opensUsed      Int               @default(0) @map("opens_used")
  openedAt       DateTime?         @map("opened_at")
  revokedAt      DateTime?         @map("revoked_at")
  status         SharedMediaStatus @default(active)
  createdAt      DateTime          @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("message_attachments")
}

model PrivateAlbum {
  id                     String            @id @default(uuid()) @db.Uuid
  ownerId                String            @map("owner_id") @db.Uuid
  name                   String            @default("Private album")
  defaultAccessPolicy    MediaAccessPolicy @default(standard) @map("default_access_policy")
  defaultDurationSeconds Int?              @map("default_duration_seconds")
  defaultMaxOpens        Int?              @map("default_max_opens")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  items  PrivateAlbumItem[]
  shares AlbumShare[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("private_albums")
}

model PrivateAlbumItem {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  storagePath String   @map("storage_path")
  position    Int      @default(0)
  albumId     String?  @map("album_id") @db.Uuid
  mediaKind   String   @default("image") @map("media_kind")
  caption     String?
  createdAt   DateTime @default(now()) @map("created_at")

  album PrivateAlbum? @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([ownerId, position])
  @@index([albumId, position])
  @@map("private_album_items")
}

model AlbumGrant {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @map("owner_id") @db.Uuid
  granteeId  String      @map("grantee_id") @db.Uuid
  status     GrantStatus @default(pending)
  createdAt  DateTime    @default(now()) @map("created_at")
  resolvedAt DateTime?   @map("resolved_at")

  owner   User @relation("AlbumGrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grantee User @relation("AlbumGrantGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@unique([ownerId, granteeId])
  @@index([granteeId, status])
  @@map("album_grants")
}

model AlbumShare {
  id             String            @id @default(uuid()) @db.Uuid
  albumId        String            @map("album_id") @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  senderId       String            @map("sender_id") @db.Uuid
  recipientId    String            @map("recipient_id") @db.Uuid
  accessPolicy   MediaAccessPolicy @default(standard) @map("access_policy")
  expiresAt      DateTime?         @map("expires_at")
  maxOpens       Int?              @map("max_opens")
  opensUsed      Int               @default(0) @map("opens_used")
  openedAt       DateTime?         @map("opened_at")
  revokedAt      DateTime?         @map("revoked_at")
  status         SharedMediaStatus @default(pending)
  createdAt      DateTime          @default(now()) @map("created_at")

  album        PrivateAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("album_shares")
}

// =============================================================================
// Pet (KingPet)
// =============================================================================

model KingPet {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  name            String    @default("Kingsley")
  stage           String    @default("hatchling")
  mood            String    @default("happy")
  bones           Int       @default(50)
  hunger          Int       @default(75)
  happiness       Int       @default(75)
  experience      Int       @default(0)
  level           Int       @default(1)
  streak          Int       @default(0)
  activity        String    @default("at_home")
  costume         String?
  wardrobe        Json      @default("[]")
  equipped        Json      @default("[]")
  adventures      Json      @default("[]")
  moodLog         Json      @default("[]") @map("mood_log")
  lastFedAt       DateTime? @map("last_fed_at")
  lastPlayedAt    DateTime? @map("last_played_at")
  lastAdventureAt DateTime? @map("last_adventure_at")
  adventureEndsAt DateTime?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("king_pet")
}

model PetItem {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  type          String
  emoji         String?
  boneCost      Int     @map("bone_cost")
  stageRequired String  @default("egg") @map("stage_required")

  @@map("pet_items")
}

model PetAdventure {
  id              String  @id @default(uuid()) @db.Uuid
  theme           String
  description     String?
  emoji           String?
  durationMinutes Int     @default(30) @map("duration_minutes")
  boneCost        Int     @map("bone_cost")
  rewardType      String  @default("xp") @map("reward_type")
  rewardAmount    Int     @default(40) @map("reward_amount")

  @@map("pet_adventures")
}

// =============================================================================
// Economy — Wallet, Transactions, Consumables, Subscriptions
// =============================================================================

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Int      @default(50)
  currency  String   @default("bones")
  lifetime  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallet")
}

model WalletTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  walletId    String   @map("wallet_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  type        String
  amount      Int
  balance     Int
  description String
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model ConsumablesInventory {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  itemKey   String    @map("type")
  quantity  Int       @default(1)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@map("consumables_inventory")
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  plan                 String    @default("free")
  tier                 String    @default("free")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  status               String    @default("active")
  expiresAt            DateTime?
  canceledAt           DateTime?
  autoRenew            Boolean   @default(true)
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("subscriptions")
}

// =============================================================================
// Notifications
// =============================================================================

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  title      String
  body       String?
  fromUserId String?   @map("actor_id") @db.Uuid
  deepLink   String?   @map("href")
  read       Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// =============================================================================
// Groups
// =============================================================================

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  coverUrl    String?  @map("cover_url")
  icon        String?
  privacy     String   @default("public")
  createdById String?  @map("created_by") @db.Uuid
  memberCount Int      @default(0) @map("member_count")
  createdAt   DateTime @default(now()) @map("created_at")

  creator  User?          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members  GroupMember[]
  messages GroupMessage[]

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model GroupMessage {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  content   String
  type      String   @default("text")
  createdAt DateTime @default(now()) @map("created_at")

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("group_messages")
}

// =============================================================================
// Tribes
// =============================================================================

model Tribe {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  icon        String?
  memberCount Int      @default(0) @map("member_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("tribes")
}

// =============================================================================
// Fansites
// =============================================================================

model Fansite {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  name            String
  displayName     String?  @map("display_name")
  headline        String?
  bio             String?
  mainPhotoUrl    String?  @map("main_photo_url")
  packageSize     String?  @map("package_size")
