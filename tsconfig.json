{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "prisma/seed.ts",
    "src/generated/**",
    "**/*.test.ts",
    "vitest.config.ts",
    "supabase/functions/**"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      "date-fns": ["./node_modules/date-fns"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "@webgpu/types"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
