# ── FYK environment ──────────────────────────────────────────────────────────
# Only the variables below are read by this codebase. There is no Stripe, no
# Sentry, no OpenAI and no Redis in FYK — the previous file listed keys for all
# of them, which read as features that do not exist.

# Browser (Vite inlines VITE_* into the public bundle — never put a secret here)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# "production" switches the auth cookie to SameSite=Lax + Secure.
VITE_APP_ENV=development

# Server (the /api/* routes). These may be the same values as above: the anon key
# is not a secret, and the API deliberately has no privileged key — every query
# runs as the signed-in user under Row Level Security.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY is intentionally unsupported. If it is set, /api/health
# reports serviceKeyPresent: true so the misconfiguration is visible in the open.
# The admin/ moderation endpoints do not use one: role checks are in SQL.

# Migrations live in supabase/migrations and are applied with the Supabase CLI
# (`pnpm db:push`) or the dashboard SQL editor, in filename order.
