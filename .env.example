# ═══════════════════════════════════════════════════════════════════════════════
# FYK — environment template.  Copy to .env.local (git-ignored) and fill in.
# ═══════════════════════════════════════════════════════════════════════════════
# Two namespaces, on purpose:
#   VITE_*   → inlined into the browser bundle at build time. NEVER put a secret
#              behind a VITE_ var: it is readable by every visitor.
#   others   → server-only (process.env), never sent to the client.
#
# This file is read three ways, and no dependency does it: Vite loads `.env.local`
# for `dev`/`build`; `drizzle.config.ts` and `scripts/seed.mjs` parse it themselves
# for the db:* scripts. (`dotenv-cli` used to wrap those scripts and was removed with
# the rest of the Prisma era — leaving `pnpm db:push` reading an environment that had
# never set `DATABASE_URL`, which is why the two loaders above exist.) A variable you
# export in the shell always wins over the file.

# ── Supabase (project URL + publishable/anon key) ────────────────────────────
# Client instance (anon key is public by design; RLS is the security boundary).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-or-publishable-key
# Same values for the server: the API verifies tokens and calls GoTrue.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-or-publishable-key

# Verifies the Supabase JWT locally (HS256) instead of calling GoTrue per
# request. Project Settings → API → JWT Secret. Leave unset to force
# introspection, which is slower but survives key rotation.
#
# Set it in production for a second reason: it is what lets a *document* render
# decide who is asking (`#/lib/document-auth.server`, AUDIT §2.16). With the secret
# present, a verification is one HMAC and a bad signature is final. Without it every
# request depends on GoTrue being reachable, and while `GET /api/*` correctly answers
# 401 when it is not, an HTML document deliberately still renders rather than bouncing
# a signed-in user off the screen during an outage.
SUPABASE_JWT_SECRET=

# Used by service-role-only jobs (none in the request path today).
SUPABASE_SERVICE_ROLE_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Use the *transaction* pooler (port 6543) in serverless/container deploys:
# postgres.js runs with `prepare: false`, which that pooler requires.
# Direct connection (5432) is fine locally, where prepared statements work.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# ── App ──────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:3000
# `development` | `staging` | `production`. Gates HSTS, CSP relaxations, logs.
VITE_APP_ENV=development
LOG_LEVEL=info

# Hosts allowed to reach `vite dev`/`vite preview` in PRODUCTION (comma-
# separated, no scheme). Vite blocks unknown `Host` headers as DNS-rebinding
# protection; behind a proxy or a tunnel that rewrites `Host`, list the exact
# public domains here. Outside production the check is relaxed automatically.
ALLOWED_HOSTS=

# Extra origins allowed to call the JSON API cross-site (comma-separated).
# Same-site traffic works without this; leave empty unless a second frontend
# really needs to read these endpoints.
CORS_ALLOWED_ORIGINS=

# ── Maps ─────────────────────────────────────────────────────────────────────
VITE_MAPBOX_ACCESS_TOKEN=pk.YOUR-MAPBOX-TOKEN

# ── Rate limiting (optional) ─────────────────────────────────────────────────
# Without these the limiter falls back to a per-process in-memory bucket, which
# is correct for one container and only approximate when you scale out.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics / error reporting (optional, browser) ─────────────────────────
VITE_ANALYTICS_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Any JSON collector (Sentry envelope proxy, GlitchTip, your own route).
VITE_ERROR_REPORT_ENDPOINT=

# ── Push delivery (edge function only — see supabase/functions/notify) ──────
# `src/routes/api/push/subscribe.ts` stores subscriptions; delivery happens in the
# `notify` edge function, which signs payloads with VAPID_PRIVATE_KEY. The browser
# needs the matching public key to subscribe at all: notifications-client.tsx reads
# VITE_VAPID_PUBLIC_KEY and returns silently when it is empty, so without it the app
# simply never asks for push permission (that is the intended default, not a bug).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@your-domain.example

# Both functions below *refuse to run* while their token is unset, and Postgres must present
# the matching value. `node scripts/vapid-keys.mjs` generates a key pair and both tokens.
#   supabase secrets set PUSH_INTERNAL_TOKEN=… CRON_INTERNAL_TOKEN=… DIVINE_INTERNAL_TOKEN=…
#   alter role authenticated set fyk.push_notify_token = '<PUSH_INTERNAL_TOKEN>';
PUSH_INTERNAL_TOKEN=
# `cron-cleanup` deletes expired sessions/stories/MeetNow rows with the service role, so an
# unauthenticated URL for it is a denial-of-service endpoint. Set `verify_jwt = false` (already
# in supabase/config.toml) *together* with this, and send it as `x-fyk-cron-token`.
CRON_INTERNAL_TOKEN=
# `divine-complete` handles scheduled messages, translation, photo scoring, emergency SMS, rate limiting, privacy reports, deletion grace — all privileged with service role.
# Set `verify_jwt = false` (already in config.toml) *together* with this, and send as `x-fyk-divine-token`.
DIVINE_INTERNAL_TOKEN=

# The URL `supabase/functions/notify` is invoked at, by the trigger 0023 puts on
# `notifications`. It is a Postgres setting, not a process env — the migration reads
# `current_setting('fyk.push_notify_url')` and does nothing while it is empty, which is
# the safe default (no push, no failed migration). Set it once `notify` is deployed:
#   alter role authenticated set fyk.push_notify_url =
#     'https://YOUR-PROJECT-REF.functions.supabase.co/v1/notify';
# The trigger also checks that the `net` schema exists, so a project without `pg_net`
# installed skips delivery instead of aborting the insert.

# ── Feature flags (browser; `src/integrations/supabase/env.ts`) ─────────────
# These gate UI surfaces whose server half may not exist yet, so the honest default is
# the one that hides the affordance rather than the one that shows a dead button.
VITE_ENABLE_UPLOADS=true
VITE_ENABLE_EVENT_CREATION=true
VITE_ENABLE_PRECISE_LOCATION=false
VITE_ENABLE_BILLING=false
# Demo/offline mode (`src/domains/demo`); keep false outside a sandbox.
VITE_ENABLE_DEMO=false

# ── Local dev / scripts ──────────────────────────────────────────────────────
# `vite.config.ts` reads PORT (default 3000).
PORT=3000
# `scripts/seed.mjs` falls back to SUPABASE_DB_URL when DATABASE_URL is unset, and the
# demo logins it creates share this password — change it, or the seeded accounts are
# as public as this file.
SUPABASE_DB_URL=
FYK_SEED_PASSWORD=
