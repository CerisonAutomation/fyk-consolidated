  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.33",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.2",
    "@types/pg": "8.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.72",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:code",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed.mjs",
    "format": "biome format",
    "lint": "biome lint",
    "lint:code": "biome check --formatter-enabled=false --assist-enabled=false src/lib src/routes/api src/integrations src/domains/auth src/middleware.ts src/db.ts src/schema.ts drizzle",
    "lint:changed": "node scripts/lint-gate.mjs",
    "lint:baseline": "node scripts/lint-gate.mjs --update-baseline",
    "check": "biome check",
    "clean": "rm -rf dist .tanstack node_modules/.cache .turbo playwright-report test-results",
    "test:e2e": "playwright test",
    "db:migrate:sql": "for f in supabase/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done"
  }
}
