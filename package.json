{
  "name": "fyk-consolidated",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "@supabase/realtime-js": "2.116.0"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@floating-ui/dom": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/realtime-js": "^2.116.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "0.48.0",
    "@tanstack/ai-anthropic": "0.17.1",
    "@tanstack/ai-client": "0.26.0",
    "@tanstack/ai-gemini": "0.25.1",
    "@tanstack/ai-ollama": "0.9.4",
    "@tanstack/ai-openai": "0.21.1",
    "@tanstack/ai-react": "0.21.3",
    "@tanstack/devtools-event-client": "0.5.0",
    "@tanstack/react-query": "5.102.0",
    "@tanstack/react-query-devtools": "5.102.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.2",
    "immer": "^11.1.18",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.30.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.418.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.86.0",
    "resend": "^6.22.0",
    "sharp": "^0.35.3",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
