  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm check:changed",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "clean": "rm -rf dist .tanstack node_modules/.cache .turbo playwright-report test-results",
    "test:e2e": "playwright test",
    "db:migrate:sql": "psql \"$DATABASE_URL\" -f supabase/migrations",
    "check:changed": "biome check src/lib src/routes/api drizzle src/db.ts src/schema.ts"
  },
