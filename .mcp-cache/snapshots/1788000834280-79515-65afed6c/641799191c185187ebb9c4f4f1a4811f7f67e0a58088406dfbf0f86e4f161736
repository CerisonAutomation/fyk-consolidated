import { create } from 'zustand';
import {
	type GridSearchFilters,
	defaultFilters,
	setPreferences,
	getPreferences,
} from '#/domains/settings/preferences';
import { deepEqual } from '#/core/lib/deep-equal';

interface GridSearchFiltersState {
	value: GridSearchFilters | null;
	ready: Promise<void>;
	onQueryChange: () => void;
	setFilters: (filters: Partial<GridSearchFilters>) => void;
	resetFilters: () => void;
	reset: () => void;
	snapshot: () => GridSearchFilters;
}

export const useGridSearchFiltersStore = create<GridSearchFiltersState>((set, get) => ({
	value: { ...defaultFilters },
	ready: Promise.resolve(),
	onQueryChange: () => {},

	set onQueryChange_(handler: () => void) {
		set({ onQueryChange: handler });
	},

	snapshot: () => {
		const { value } = get();
		return { ...(value ?? defaultFilters) };
	},

	setFilters: (gridSearchFilters) => {
		const oldValue = get().value;
		const newValue = Object.assign({}, oldValue, gridSearchFilters);
		if (!deepEqual(oldValue, newValue)) {
			set({ value: newValue });
			void setPreferences({ gridSearchFilters: newValue });
			get().onQueryChange();
		}
	},

	resetFilters: () => {
		const newValue = { ...defaultFilters };
		set({ value: newValue });
		void setPreferences({ gridSearchFilters: newValue });
	},

	reset: () => {
		set({ value: { ...defaultFilters } });
	},
}));

// Initialize from disk
export async function initGridSearchFilters(): Promise<void> {
	try {
		const { gridSearchFilters } = await getPreferences();
		useGridSearchFiltersStore.setState({
			value: gridSearchFilters ?? defaultFilters,
		});
	} catch (error) {
		console.error(error);
	}
}
