/** Routes that are public — no auth required, no NavBar */
const PUBLIC_ROUTES = [
	"/",
	"/about",
	"/auth/sign-in",
	"/auth/sign-up",
	"/auth/callback",
	"/onboarding",
];

function isPublicRoute(pathname: string): boolean {
	return PUBLIC_ROUTES.some(
		(route) => pathname === route || pathname.startsWith(`${route}/`),
	);
}

/**
 * Layout wrapper: shows NavBar ONLY for authenticated users on protected pages.
 * Public pages (landing, about, auth, onboarding) render without NavBar.
 */
function AppLayout({ children }: { children: React.ReactNode }) {
	const { session, loading, user } = useSupabaseSession();
	const setAuth = useAuthStore((s) => s.setAuth);

	const pathname = useRouterState({
		select: (state) => state.location.pathname,
	});

	useAutoSavePreferences();

	// Keep Zustand auth store in sync with Supabase session
	useEffect(() => {
		if (user) {
			setAuth({ userId: user.id, user });
		} else if (!loading && !session) {
			setAuth(null);
		}
	}, [user, session, loading, setAuth]);

	// Public routes: no NavBar, full-screen content
	if (isPublicRoute(pathname)) {
		return <>{children}</>;
	}

	// Live deployments require Supabase auth. The bundled local demo is a
	// complete interactive product preview and must retain its navigation shell.
	if (!demoEnabled && !loading && !session) {
		return <>{children}</>;
	}

	// Protected routes while authenticated: show NavBar
	return (
		<>
			<NavBar />
			<div className="pb-16 lg:pt-14 lg:pb-0 lg:pl-[240px] min-h-screen">
				{children}
			</div>
		</>
	);
}

