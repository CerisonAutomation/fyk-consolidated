import type { ReactNode } from "react";
import { Plane } from "lucide-react";
import { cn } from "../cn";

interface ProfileStatusIndicatorProps {
  onlineUntil: number | null | undefined;
  isVisiting?: boolean;
  className?: string;
}

function ProfileStatusIndicator({
  onlineUntil,
  isVisiting = false,
  className,
}: ProfileStatusIndicatorProps): ReactNode {
  const online = (onlineUntil ?? 0) > Date.now() / 1000;

  if (!isVisiting && !online) return null;

  const title = (() => {
    if (online && isVisiting) return "Online now. Visiting";
    if (online) return "Online now";
    if (isVisiting) return "Visiting";
    return undefined;
  })();

  return (
    <div
      className={cn(
        "flex shrink-0",
        online ? "text-green-500" : "text-gray-400",
        className,
      )}
      title={title}
    >
      {isVisiting ? (
        <Plane className="size-3" fill="currentColor" />
      ) : (
        <span className="size-2 rounded-full bg-green-500" />
      )}
      <span className="sr-only">{title}</span>
    </div>
  );
}
