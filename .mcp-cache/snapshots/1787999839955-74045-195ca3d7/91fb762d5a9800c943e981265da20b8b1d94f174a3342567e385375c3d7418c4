            <Crown className="w-3.5 h-3.5" />
            <span>GO KING</span>
          </Link>
        </div>

        {/* User info + Sign Out */}
        {user && (
          <div className="p-4 border-t border-white/[0.06]">
            <div className="flex items-center gap-3 mb-3 px-1">
              <div className="w-8 h-8 rounded-full bg-gold/10 border border-gold/20 flex items-center justify-center">
                <User className="w-4 h-4 text-gold" />
              </div>
              <div className="flex-1 min-w-0">
                <p className="text-xs font-medium text-foreground/80 truncate">
                  {user.email}
                </p>
              </div>
            </div>
            <button
              onClick={() => {
                onClose();
                signOut();
              }}
              className="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border border-red-500/20 text-red-400 hover:bg-red-500/10 hover:border-red-500/30 transition-all duration-200 text-xs font-medium"
            >
              <LogOut className="w-3.5 h-3.5" />
              <span>Sign Out</span>
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

/* ================================================================== */
/*  Main NavBar Export                                                 */
/* ================================================================== */

export function NavBar() {
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

  // Read unread chat count from the store
  const entries = useConversationsStore((s) => s.entries);
  const unreadChat = useMemo(
    () => entries.reduce((sum, e) => sum + e.data.unreadCount, 0),
    [entries],
  );

  return (
    <>
      {/* ── Desktop Sidebar (lg+) ── */}
      <DesktopSidebar />

      {/* ── Desktop Top Header (lg+, right of sidebar) ── */}
      <DesktopTopHeader unreadChat={unreadChat} />

      {/* ── Mobile Bottom Tab Bar (<lg) — single bar, no top header ── */}
      <MobileBottomBar
        unreadChat={unreadChat}
        onMenuOpen={() => setMobileMenuOpen(true)}
      />

      {/* ── Mobile More Drawer ── */}
      <MobileMoreDrawer
        open={mobileMenuOpen}
        onClose={() => setMobileMenuOpen(false)}
      />
    </>
  );
}
