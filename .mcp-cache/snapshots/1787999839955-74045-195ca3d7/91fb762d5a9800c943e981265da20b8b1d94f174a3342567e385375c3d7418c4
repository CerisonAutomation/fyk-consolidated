/* ================================================================== */
/*  Utility: check if a nav item is active                             */
/* ================================================================== */

function isNavActive(
  pathname: string,
  href: string,
  matchPattern?: string,
): boolean {
  if (matchPattern) {
    return new RegExp(matchPattern).test(pathname);
  }
  // Exact match for short paths, prefix match for longer paths
  if (pathname === href) return true;
  if (href !== "/" && pathname.startsWith(href + "/")) return true;
  return false;
}

/* ================================================================== */
/*  ThemeToggle                                                        */
/* ================================================================== */

function ThemeToggle() {
  const [mode, setMode] = useState<"light" | "dark" | "auto">("dark");

  useEffect(() => {
    if (typeof window === "undefined") return;
    const stored = window.localStorage.getItem("theme");
    if (stored === "light" || stored === "dark" || stored === "auto") {
      setMode(stored);
    }
  }, []);

  const toggle = useCallback(() => {
    const next = mode === "light" ? "dark" : mode === "dark" ? "auto" : "light";
    setMode(next);
    window.localStorage.setItem("theme", next);

    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const resolved = next === "auto" ? (prefersDark ? "dark" : "light") : next;
    document.documentElement.classList.remove("light", "dark");
    document.documentElement.classList.add(resolved);
    if (next === "auto") {
      document.documentElement.removeAttribute("data-theme");
    } else {
      document.documentElement.setAttribute("data-theme", next);
    }
    document.documentElement.style.colorScheme = resolved;
  }, [mode]);

  return (
    <button
      onClick={toggle}
      className="flex items-center justify-center w-9 h-9 rounded-full border border-white/[0.08] bg-white/[0.03] backdrop-blur text-muted-foreground hover:border-gold/50 hover:text-gold hover:bg-gold/5 transition-all duration-300"
      aria-label={`Theme: ${mode}. Click to cycle.`}
    >
      {mode === "dark" ? (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      ) : mode === "light" ? (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      ) : (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
      )}
    </button>
  );
}

