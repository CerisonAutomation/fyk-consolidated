/* Sidebar badge that reads from the chat store */
function SidebarBadge() {
  const entries = useConversationsStore((s) => s.entries);
  const unread = useMemo(
    () => entries.reduce((sum, e) => sum + e.data.unreadCount, 0),
    [entries],
  );
  if (unread <= 0) return null;
  return (
    <span className="inline-flex items-center justify-center min-w-[16px] h-4 px-1 rounded-full bg-red text-white text-[9px] font-bold leading-none">
      {unread > 99 ? "99+" : unread}
    </span>
  );
}

/* ================================================================== */
/*  Mobile More Drawer (right-side slide-out)                          */
/* ================================================================== */

function MobileMoreDrawer({
  open,
  onClose,
}: {
  open: boolean;
  onClose: () => void;
}) {
  const location = useLocation();
  const pathname = location.pathname;
  const drawerRef = useRef<HTMLDivElement>(null);
  const { user } = useSupabaseSession();

  useEffect(() => {
    if (open) {
      document.body.style.overflow = "hidden";
    }
    return () => {
      document.body.style.overflow = "";
    };
  }, [open]);

  // Focus trap
  useEffect(() => {
    if (open && drawerRef.current) {
      const first = drawerRef.current.querySelector<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      first?.focus();
    }
  }, [open]);

  // Escape to close
  useEffect(() => {
    if (!open) return;
    const handler = (e: KeyboardEvent) => {
      if (e.key === "Escape") onClose();
    };
    document.addEventListener("keydown", handler);
    return () => document.removeEventListener("keydown", handler);
  }, [open, onClose]);

  if (!open) return null;

  return (
    <div
      className="fixed inset-0 z-[60] lg:hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Navigation menu"
    >
      {/* Backdrop */}
      <div
        className="absolute inset-0 bg-black/70 backdrop-blur-sm animate-in fade-in-0 duration-150"
        onClick={onClose}
      />

      {/* Drawer panel */}
      <div
        ref={drawerRef}
        className="absolute right-0 top-0 bottom-0 w-full sm:w-80 bg-black/80 backdrop-blur-2xl border-l border-white/[0.08] overflow-y-auto animate-in slide-in-from-right duration-200"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Close button */}
        <div className="flex items-center justify-between p-4 border-b border-white/[0.06]">
          <FYKLogo collapsed />
          <button
            onClick={onClose}
            className="w-9 h-9 rounded-lg border border-white/[0.06] bg-white/[0.02] flex items-center justify-center hover:border-gold/40 hover:text-gold transition-all duration-200 text-muted-foreground"
            aria-label="Close menu"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* All navigation links */}
        <nav className="p-4 flex flex-col gap-1" aria-label="Additional navigation">
          {/* Primary tabs repeated for easy access */}
          {MOBILE_TABS.map((item) => {
            const Icon = item.icon;
            const active = isNavActive(pathname, item.href, item.matchPattern);
            return (
              <Link
                key={item.href}
